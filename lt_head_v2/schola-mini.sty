\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{schola-mini}[2026/07/24 Minimal layout and packages for jlreq]

\RequirePackage{graphicx}
\RequirePackage{xcolor}
\RequirePackage{amsmath}

\RequirePackage{luatexja,luatexja-fontspec}
\RequirePackage[math-style=ISO]{unicode-math}

\setmainfont{TeX Gyre Schola}
\setsansfont{TeX Gyre Heros}
\setmathfont{ScholaMath-TY}
\setmainjfont[RawFeature={+kern,+pkna},BoldFont={A P-OTF Ryumin Pr6N B-KL}]{A P-OTF Ryumin Pr6N R-KL}
\setsansjfont[RawFeature={+kern,+pkna},BoldFont={PA1GothicStdN-Medium}]{PA1GothicStdN-Regular}

\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\leftmark}
\fancyhead[R]{\thepage}
\setlength{\headheight}{16.35997pt}
\addtolength{\topmargin}{-6.40172pt}

\RequirePackage{adfbullets}
\renewcommand{\labelitemi}{\adfbullet{27}}
\renewcommand{\labelitemii}{\adfbullet{52}}
\renewcommand{\labelitemiii}{\adfbullet{32}}

\jlreqsetup{
  itemization_beforeafter_space = 0pt,
  itemization_labelsep = 0.5\zw,
  caption_font = \small,
  caption_label_font = \small\bfseries,
}

\ModifyHeading{section}{
  lines=2,
  before_lines=1
}

\ModifyHeading{subsection}{
  font={\normalsize\bfseries\sffamily\gtfamily},
  lines=1,
  before_lines=1
}

\ModifyHeading{subsubsection}{
  font={\normalsize\bfseries\sffamily\gtfamily},
  lines=1,
  before_lines=0
}

\SetBlockHeadingSpaces{
  {
    _section{lines=2, before_lines=1},
    _subsection{lines=1, before_lines=0},
    _subsubsection{lines=1, before_lines=0}
  }
  {
    _section{lines=2, before_lines=1},
    _subsection{lines=1, before_lines=0}
  }
  {
    _subsection{lines=1, before_lines=1},
    _subsubsection{lines=1, before_lines=0}
  }
}

\RequirePackage[luatex,pdfencoding=auto]{hyperref}
\definecolor{deepcarrotorange}{rgb}{0.91, 0.11, 0.7}
\hypersetup{
  colorlinks = true,
  allcolors = {deepcarrotorange},
}

\endinput
